                            <span class="text-slate-400 block">按摩小費</span>
                            <span class="font-bold text-slate-800 text-sm">100 披索</span>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-sky-100">
                            <span class="text-slate-400 block">體驗潛水小費</span>
                            <span class="font-bold text-slate-800 text-sm">200 披索</span>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-sky-100">
                            <span class="text-slate-400 block">ATV 越野車小費</span>
                            <span class="font-bold text-slate-800 text-sm">50 披索</span>
                        </div>
                    </div>
                    <p class="text-xs text-slate-500">※ 其他項目小費現場將由導遊另行告知，建議平日多留存 50、100 披索紙鈔備用。</p>
                </div>
            </section>

            <!-- ==================== 第 5 頁：匯率換算 ==================== -->
            <section id="page-4" class="page-content space-y-6">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-sm"><i class="fa-solid fa-calculator"></i></span>
                        即時匯率換算小幫手
                    </h2>
                    <span class="text-xs font-semibold text-slate-400 tracking-widest">PAGE 05 / 05</span>
                </div>

                <!-- 匯率設定列 -->
                <div class="bg-amber-50/80 border border-amber-200 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
                    <div class="flex items-center gap-2 text-amber-900 font-bold">
                        <i class="fa-solid fa-sliders text-amber-600"></i>
                        <span>導遊參考匯率（可依當日現場換匯微調）：</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <label class="flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-xl border border-amber-200">
                            <span class="text-xs text-slate-500">1 TWD =</span>
                            <input type="number" id="rate-twd-php" value="1.7" step="0.05" min="0.1" oninput="convertFromPHP()" class="w-16 font-bold text-sky-700 focus:outline-none text-right">
                            <span class="text-xs text-slate-500">PHP</span>
                        </label>
                        <label class="flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-xl border border-amber-200">
                            <span class="text-xs text-slate-500">1 USD =</span>
                            <input type="number" id="rate-usd-php" value="58.0" step="0.5" min="1" oninput="convertFromPHP()" class="w-16 font-bold text-teal-700 focus:outline-none text-right">
                            <span class="text-xs text-slate-500">PHP</span>
                        </label>
                    </div>
                </div>

                <!-- 雙向金額輸入卡片 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- 菲律賓披索 PHP -->
                    <div class="bg-gradient-to-br from-sky-50 to-white border-2 border-sky-200 rounded-2xl p-5 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-md">當地貨幣</span>
                            <span class="font-bold text-slate-500 text-sm">PHP 披索</span>
                        </div>
                        <div class="relative mt-2">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold">₱</span>
                            <input type="number" id="input-php" value="170" min="0" oninput="convertFromPHP()" placeholder="輸入披索金額" class="w-full pl-8 pr-3 py-3 text-2xl font-bold text-slate-900 bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:outline-none">
                        </div>
                    </div>

                    <!-- 新台幣 TWD -->
                    <div class="bg-gradient-to-br from-indigo-50 to-white border-2 border-indigo-200 rounded-2xl p-5 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-md">台灣貨幣</span>
                            <span class="font-bold text-slate-500 text-sm">TWD 新台幣</span>
                        </div>
                        <div class="relative mt-2">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold">NT$</span>
                            <input type="number" id="input-twd" value="100" min="0" oninput="convertFromTWD()" placeholder="輸入台幣金額" class="w-full pl-12 pr-3 py-3 text-2xl font-bold text-slate-900 bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:outline-none">
                        </div>
                    </div>

                    <!-- 美金 USD -->
                    <div class="bg-gradient-to-br from-teal-50 to-white border-2 border-teal-200 rounded-2xl p-5 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-teal-700 bg-teal-100 px-2.5 py-0.5 rounded-md">換匯常用</span>
                            <span class="font-bold text-slate-500 text-sm">USD 美金</span>
                        </div>
                        <div class="relative mt-2">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold">US$</span>
                            <input type="number" id="input-usd" value="2.93" min="0" oninput="convertFromUSD()" placeholder="輸入美金金額" class="w-full pl-12 pr-3 py-3 text-2xl font-bold text-slate-900 bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-teal-500 focus:border-teal-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- 常見消費與小費快速點選 -->
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-500"></i>
                            <span>常見情境快速代入（點擊金額立即換算）</span>
                        </h3>
                        <button onclick="setPHP(0)" class="text-xs text-slate-500 hover:text-slate-800 underline">歸零清除</button>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
                        <button onclick="setPHP(50)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">床頭 / 船家 / ATV小費</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 50 PHP</span>
                        </button>
                        <button onclick="setPHP(100)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">薄荷行李(單程) / 按摩</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 100 PHP</span>
                        </button>
                        <button onclick="setPHP(200)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">體驗潛水小費</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 200 PHP</span>
                        </button>
                        <button onclick="setPHP(500)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">伴手禮 / 芒果乾</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 500 PHP</span>
                        </button>
                        <button onclick="setPHP(1000)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">資生堂島自費海鮮</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 1,000 PHP</span>
                        </button>
                        <button onclick="setPHP(3500)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">購物中心血拼</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 3,500 PHP</span>
                        </button>
                        <button onclick="setPHP(5000)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">大額換匯參考</span>
                            <span class="font-bold text-slate-800 text-sm">₱ 5,000 PHP</span>
                        </button>
                        <button onclick="setPHP(10000)" class="p-3 bg-white hover:bg-sky-50 border border-slate-200 hover:border-sky-300 rounded-xl text-left transition">
                            <span class="text-slate-400 block">菲律賓最高禁菸罰鍰</span>
                            <span class="font-bold text-rose-600 text-sm">₱ 10,000 PHP</span>
                        </button>
                    </div>
                </div>

                <!-- 換匯小叮嚀 -->
                <div class="bg-sky-50/70 border border-sky-200/80 rounded-2xl p-4 text-xs text-slate-600 space-y-1.5 leading-relaxed">
                    <div class="font-bold text-sky-900 text-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-lightbulb text-sky-600"></i>
                        <span>當地換匯與用錢小撇步</span>
                    </div>
                    <p>• <strong>可直接帶台幣或美金跟導遊換披索：</strong>參考匯率約為 <strong>台幣 1：1.7 披索</strong>、<strong>美元 1：58 披索</strong>（以當日實際匯率為主）。當地信用卡較不好用，建議備妥現金並攜帶一張信用卡以防萬一。</p>
                    <p>• <strong>多準備 20、50、100 元小鈔：</strong>當地給小費（<strong>務必給鈔票不可給硬幣</strong>）或向島上小販買飲料、零食時，小面額紙鈔最方便使用。</p>
                </div>
            </section>

        </main>

        <!-- 手冊底部翻頁控制列 (Footer Pagination) -->
        <footer class="no-print bg-slate-50 border-t border-slate-200 px-5 py-4 flex items-center justify-between">
            <button id="prev-btn" onclick="changePage(-1)" class="px-4 py-2 rounded-xl text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none transition flex items-center gap-2">
                <i class="fa-solid fa-chevron-left"></i>
                <span>上一頁</span>
            </button>

            <!-- 頁碼指示點 -->
            <div class="flex items-center gap-2" id="page-dots">
                <button onclick="switchPage(0)" class="w-2.5 h-2.5 rounded-full bg-sky-600 transition-all"></button>
                <button onclick="switchPage(1)" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all"></button>
                <button onclick="switchPage(2)" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all"></button>
                <button onclick="switchPage(3)" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all"></button>
                <button onclick="switchPage(4)" class="w-2.5 h-2.5 rounded-full bg-slate-300 transition-all"></button>
            </div>

            <button id="next-btn" onclick="changePage(1)" class="px-4 py-2 rounded-xl text-sm font-bold text-white bg-sky-600 hover:bg-sky-700 disabled:opacity-40 disabled:pointer-events-none transition flex items-center gap-2 shadow-sm">
                <span>下一頁</span>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </footer>
    </div>

    <!-- 提示訊息框 (Toast Notification) -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs font-medium px-4 py-2.5 rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 z-50">
        已複製飯店英文地址！
    </div>

    <script>
        let currentPage = 0;
        const totalPages = 5;

        /**
         * 切換至指定分頁
         * @param {number} pageIndex - 目標分頁索引 (0 ~ 4)
         */
        function switchPage(pageIndex) {
            if (pageIndex < 0 || pageIndex >= totalPages) return;
            currentPage = pageIndex;

            // 1. 更新內容區塊顯示狀態
            for (let i = 0; i < totalPages; i++) {
                const pageEl = document.getElementById(`page-${i}`);
                const tabEl = document.getElementById(`tab-${i}`);
                if (i === currentPage) {
                    pageEl.classList.add('active');
                    tabEl.classList.add('active');
                    // 確保手機版分頁書籤自動滾動至可視範圍
                    tabEl.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                } else {
                    pageEl.classList.remove('active');
                    tabEl.classList.remove('active');
                }
            }

            // 2. 更新底部指示點樣式
            const dots = document.getElementById('page-dots').children;
            for (let i = 0; i < dots.length; i++) {
                if (i === currentPage) {
                    dots[i].className = 'w-6 h-2.5 rounded-full bg-sky-600 transition-all';
                } else {
                    dots[i].className = 'w-2.5 h-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all';
                }
            }

            // 3. 更新上一頁 / 下一頁按鈕禁用狀態
            document.getElementById('prev-btn').disabled = (currentPage === 0);
            document.getElementById('next-btn').disabled = (currentPage === totalPages - 1);

            // 4. 切換頁面時平滑捲動回手冊頂部
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /**
         * 匯率換算邏輯：由披索 PHP 換算台幣與美金
         */
        function convertFromPHP() {
            const php = parseFloat(document.getElementById('input-php').value);
            const rateTwdPhp = parseFloat(document.getElementById('rate-twd-php').value) || 1.7;
            const rateUsdPhp = parseFloat(document.getElementById('rate-usd-php').value) || 58.0;

            if (isNaN(php)) {
                document.getElementById('input-twd').value = '';
                document.getElementById('input-usd').value = '';
                return;
            }
            document.getElementById('input-twd').value = (php / rateTwdPhp).toFixed(1);
            document.getElementById('input-usd').value = (php / rateUsdPhp).toFixed(2);
        }

        /**
         * 匯率換算邏輯：由台幣 TWD 換算披索與美金
         */
        function convertFromTWD() {
            const twd = parseFloat(document.getElementById('input-twd').value);
            const rateTwdPhp = parseFloat(document.getElementById('rate-twd-php').value) || 1.7;
            const rateUsdPhp = parseFloat(document.getElementById('rate-usd-php').value) || 58.0;

            if (isNaN(twd)) {
                document.getElementById('input-php').value = '';
                document.getElementById('input-usd').value = '';
                return;
            }
            const php = twd * rateTwdPhp;
            document.getElementById('input-php').value = php.toFixed(0);
            document.getElementById('input-usd').value = (php / rateUsdPhp).toFixed(2);
        }

        /**
         * 匯率換算邏輯：由美金 USD 換算披索與台幣
         */
        function convertFromUSD() {
            const usd = parseFloat(document.getElementById('input-usd').value);
            const rateTwdPhp = parseFloat(document.getElementById('rate-twd-php').value) || 1.7;
            const rateUsdPhp = parseFloat(document.getElementById('rate-usd-php').value) || 58.0;

            if (isNaN(usd)) {
                document.getElementById('input-php').value = '';
                document.getElementById('input-twd').value = '';
                return;
            }
            const php = usd * rateUsdPhp;
            document.getElementById('input-php').value = php.toFixed(0);
            document.getElementById('input-twd').value = (php / rateTwdPhp).toFixed(1);
        }

        /**
         * 快速設定披索金額並觸發換算
         * @param {number} amount - 披索金額
         */
        function setPHP(amount) {
            document.getElementById('input-php').value = amount;
            convertFromPHP();
        }

        /**
         * 相對翻頁 (+1 或 -1)
         * @param {number} delta - 翻頁方向
         */
        function changePage(delta) {
            switchPage(currentPage + delta);
        }

        /**
         * 複製文字至剪貼簿 (相容 iFrame 環境)
         * @param {string} elementId - 目標元素 ID
         */
        function copyText(elementId) {
            const text = document.getElementById(elementId).innerText;
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('已複製飯店英文地址！');
            } catch (err) {
                showToast('複製失敗，請手動選取複製');
            }
            document.body.removeChild(textarea);
        }

        /**
         * 顯示底部提示框
         * @param {string} msg - 提示文字
         */
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 2200);
        }

        // 初始化頁面狀態與鍵盤左右鍵翻頁支援
        window.onload = function() {
            switchPage(0);
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowRight') changePage(1);
                if (e.key === 'ArrowLeft') changePage(-1);
            });
        };
    </script>
</body>
</html>
